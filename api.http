@baseUrl = http://localhost:3000/api

### 1 - Verificar a API
GET {{baseUrl}}/health

### 2 - Cadastrar doador sem token
POST {{baseUrl}}/doadores
Content-Type: application/json

{
  "nome": "Teste sem token"
}

### 3 - Login com senha incorreta
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "voluntario@exemplo.com",
  "senha": "errada"
}

### 4 - Login com email inexistente
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "inexistente@exemplo.com",
  "senha": "gestao123"
}

### 5 - Login sem senha
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "voluntario@exemplo.com"
}

### 6 - Login correto
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "voluntario@exemplo.com",
  "senha": "gestao123"
}

###
@token = {{login.response.body.token}}

### 7 - Listar doadores com token
GET {{baseUrl}}/doadores
Authorization: Bearer {{token}}

### 8 - Cadastrar doador com token
POST {{baseUrl}}/doadores
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Doador Teste JWT",
  "email": "testejwt@exemplo.com"
}

### 9 - Testar token invalido
GET {{baseUrl}}/doadores
Authorization: Bearer {{token}}x